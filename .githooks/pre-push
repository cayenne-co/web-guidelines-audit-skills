#!/bin/sh
# Checks every commit about to be pushed with tools/check-public.sh, so nothing unsafe reaches the public repository.
z=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z" ] && continue          # deleting a ref
  case "$local_ref" in refs/tags/*) local_sha=$(git rev-parse "$local_sha^{commit}") ;; esac
  if [ "$remote_sha" = "$z" ]; then range="$local_sha --not --remotes=origin"; else range="$remote_sha..$local_sha"; fi
  for c in $(git rev-list $range); do
    tools/check-public.sh "$c" >/dev/null 2>"/tmp/check-public.$$" || { echo "[pre-push] commit $(git log --oneline -1 "$c")" >&2; cat "/tmp/check-public.$$" >&2; status=1; }
  done
  tools/check-public.sh "$local_sha" >/dev/null 2>&1 || status=1
done
rm -f "/tmp/check-public.$$"
[ "$status" -eq 0 ] || echo '[pre-push] Push blocked by tools/check-public.sh' >&2
exit $status
